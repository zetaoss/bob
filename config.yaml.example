server:
  port: 8080
  logLevel: info

# Unknown keys are rejected. providers.*.apiKey and proxies values may reference
# environment variables as ${NAME}; an unset variable is a startup error.

# /aigate: LLM routing with fallback. Omit models to disable the route.
aigate:
  validateModelsOnStartup: true
  fallback:
    rounds: 2
    perAttemptTimeout: 30s
  models:
    # fallback priority: first model is tried first
    # format: {provider}/{model}
    - gemini/gemini-2.5-flash
    - ollama/gemma4:31b
  providers:
    gemini:
      apiKey: ${GEMINI_API_KEY}
    ollama:
      apiKey: ${OLLAMA_API_KEY}

# /search: result counts for 2-4 queries across search engines.
# An engine is used only when its credentials are set; omit all to disable the route.
search:
  kakaoAPIKey: ${KAKAO_API_KEY}             # daum_blog
  naverClientID: ${NAVER_CLIENT_ID}         # naver_blog, naver_news
  naverClientSecret: ${NAVER_CLIENT_SECRET}
  googleAPIKey: ${GOOGLE_SEARCH_KEY}        # google_search (Custom Search JSON API)
  googleCX: ${GOOGLE_SEARCH_CX}

# /metrics/: named PromQL instant queries run against a Prometheus-compatible API.
# Names use lowercase letters, digits and _. Omit queries to disable the route.
metrics:
  prometheus: http://prometheus:9090
  queries:
    node_cpu_usage: sum by (node) (rate(node_cpu_usage_seconds_total[5m]))
    pod_count: count(count by (pod) (pod_memory_working_set_bytes{namespace="default"}))

# /cloudflare/analytics: zone analytics per hour or day. Omit to disable.
cloudflare:
  apiToken: ${CLOUDFLARE_API_TOKEN}   # needs Zone Analytics read
  zoneID: ${CLOUDFLARE_ZONE_ID}

# /<name>/... is forwarded to <url>/... (prefix stripped, query kept).
proxies:
  runbox: http://runbox
  shellbox-score: http://shellbox-score
